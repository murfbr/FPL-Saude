rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar — verifica se o usuário logado é um super-admin ativo  ← NOVO
    function isSuperAdmin() {                                                  // ← NOVO
      return request.auth != null                                              // ← NOVO
        && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/super_admins/$(request.auth.uid)).data.is_active == true;
    }                                                                          // ← NOVO

    // Função auxiliar — verifica se o usuário pertence à empresa solicitada (Com Fallback de Custom Claim)
    function isUserInCompany(companyId) {
      return request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId == companyId)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // Função auxiliar — RBAC Dinâmico por módulo lendo da configuração da Empresa  ← NOVO
    function hasModuleAccess(companyId, moduleName, action) {                  // ← NOVO
      let userRole = request.auth.token.role != null                           // ← NOVO
        ? request.auth.token.role                                              // ← NOVO
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; // ← NOVO

      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId)); // ← NOVO
      let companyRoles = companyDoc.data.get('roles', {});                     // ← NOVO
      let rolePerms = companyRoles.get(userRole, {});                          // ← NOVO
      let allowedArray = action == 'write' ? rolePerms.get('can_edit', []) : rolePerms.get('can_view', []); // ← NOVO
      
      return userRole == 'admin'                                               // ← NOVO
        || isSuperAdmin()                                                      // ← NOVO
        || moduleName in allowedArray                                          // ← NOVO
        || '*' in allowedArray;                                                // ← NOVO
    }

    // Coleção de super-admins — somente leitura do próprio documento         ← NOVO
    // Escrita bloqueada pelo app (criação só manual no Console do Firebase)   ← NOVO
    match /super_admins/{uid} {                                                // ← NOVO
      allow read: if request.auth != null && request.auth.uid == uid;          // ← NOVO
      allow write: if false;                                                   // ← NOVO
    }                                                                          // ← NOVO

    // Perfis de usuário na raiz — cada usuário pode ler/escrever o próprio documento
    // Super-admins podem ler e escrever qualquer documento (gestão de usuários) ← ALTERADO
    match /users/{uid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid
        || isSuperAdmin()                                                      // ← ALTERADO
      );
    }

    // Regra para liberar buscas do tipo collectionGroup nas novas subcoleções  ← ALTERADO
    // Agora validam se o usuário pertence à empresa correta via o caminho do documento
    match /{path=**}/subscriptions/{subscriptionId} {
      allow read, write: if request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId in path)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in path
        || isSuperAdmin()
      );
    }
    match /{path=**}/packages/{packageId} {
      allow read, write: if request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId in path)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in path
        || isSuperAdmin()
      );
    }

    // Escopo das empresas (SaaS)
    match /companies/{companyId} {
      // Leitura pública mantida (igual a antes)
      allow read: if true;
      // Super-admins podem escrever o documento de configuração da empresa  ← ALTERADO
      allow write: if isSuperAdmin();                                          // ← ALTERADO

      // Coleção de Usuários dentro da empresa (mantida igual)
      match /users/{userId} {
        allow read, write: if request.auth != null && (
          isUserInCompany(companyId)
          || isSuperAdmin()
        );
      }

      // Demais coleções — Protegido por Tenant e Módulo (RBAC Dinâmico) ← ALTERADO
      match /{module}/{document=**} {
        allow read: if module != 'users' && (
          isSuperAdmin() 
          || (isUserInCompany(companyId) && hasModuleAccess(companyId, module, 'read'))
          // Exceção de segurança: O profissional precisa ler o próprio perfil na hora do login para o sistema funcionar
          || (module == 'professionals' && isUserInCompany(companyId) && resource.data.user_id == request.auth.uid)
        );
        allow write: if module != 'users' && (
          isSuperAdmin() 
          || (isUserInCompany(companyId) && hasModuleAccess(companyId, module, 'write'))
        );
      }
    }

  }
}
