rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/super_admins/$(request.auth.uid)).data.is_active == true;
    }

    function isUserInCompany(companyId) {
      // Fallback seguro: Tenta a claim, senão lê do documento (Zero Downtime)
      return request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId == companyId)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // Função auxiliar — mapeia nomes de coleções físicas para as chaves do Registry (RolesTab)
    function getModuleKey(collectionName) {
      return collectionName == 'appointments' ? 'agenda'
           : collectionName == 'clients' ? 'patients'
           : collectionName == 'notifications' ? 'messages'
           : collectionName == 'financial' ? 'financials'
           : collectionName == 'time_tracking' ? 'timesheets'
           : collectionName;
    }

    // Função auxiliar — RBAC Dinâmico por módulo lendo da configuração da Empresa
    function hasModuleAccess(companyId, collectionName, action) {
      let moduleName = getModuleKey(collectionName);
      let userRole = request.auth.token.role != null 
        ? request.auth.token.role 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;

      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId));
      
      // Uso do Map.get() para garantir que nunca quebra (evita Null Reference se a empresa antiga não tiver 'roles')
      let companyRoles = companyDoc.data.get('roles', {});
      let rolePerms = companyRoles.get(userRole, {});
      let allowedArray = action == 'write' ? rolePerms.get('can_edit', []) : rolePerms.get('can_view', []);
      
      return userRole == 'admin' 
        || isSuperAdmin() 
        || moduleName in allowedArray 
        || '*' in allowedArray;
    }

    match /super_admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid
        || isSuperAdmin()
      );
    }

    match /{path=**}/subscriptions/{subscriptionId} {
      allow read, write: if request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId in path)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in path
        || isSuperAdmin()
      );
    }
    match /{path=**}/packages/{packageId} {
      allow read, write: if request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId in path)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in path
        || isSuperAdmin()
      );
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /users/{userId} {
        allow read, write: if request.auth != null && (
          isUserInCompany(companyId)
          || isSuperAdmin()
        );
      }

      match /{module}/{document=**} {
        allow read: if module != 'users' && (
          isSuperAdmin() 
          || (isUserInCompany(companyId) && hasModuleAccess(companyId, module, 'read'))
        );
        allow write: if module != 'users' && (
          isSuperAdmin() 
          || (isUserInCompany(companyId) && hasModuleAccess(companyId, module, 'write'))
        );
      }
    }

  }
}
