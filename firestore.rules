rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica se o usuário é um super-admin ativo
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/super_admins/$(request.auth.uid)).data.is_active == true;
    }

    // Verifica se o usuário pertence à empresa (Custom Claim com fallback no documento)
    function isUserInCompany(companyId) {
      return request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId == companyId)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // Resolve o role do usuário (token claim com fallback no documento)
    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Verifica se o usuário é admin da empresa (role 'admin') ou super-admin
    function isAdmin(companyId) {
      return isSuperAdmin() || (isUserInCompany(companyId) && getUserRole() == 'admin');
    }

    // RBAC de LEITURA por módulo.
    // Fallback: se a empresa não tiver 'roles' configurado no Firestore, libera para qualquer
    // usuário da empresa (exceto client, que é bloqueado explicitamente no allow read).
    function canViewModule(companyId, moduleName) {
      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId));
      let companyRoles = companyDoc.data.get('roles', {});
      let userRole = getUserRole();
      let rolePerms = companyRoles.get(userRole, null);
      let allowedArray = rolePerms != null ? rolePerms.get('can_view', []) : [];

      return !('roles' in companyDoc.data)   // Sem campo roles → libera (empresa legada)
        || companyRoles.size() == 0          // Campo roles vazio → libera
        || rolePerms == null                 // Role não mapeado na empresa → libera
        || allowedArray.size() == 0          // can_view não configurado → libera
        || userRole == 'admin'               // Admin sempre passa
        || moduleName in allowedArray        // Módulo explicitamente permitido
        || '*' in allowedArray;              // Wildcard — acesso total
    }

    // RBAC de ESCRITA por módulo.
    // Comportamento:
    //   - 'client' nunca pode escrever.
    //   - 'admin' sempre pode escrever.
    //   - Se a empresa NÃO tem 'roles' configurado: professional e outros roles (não client) podem
    //     escrever (fallback que reflete o DEFAULT_ROLES da aplicação).
    //   - Se a empresa TEM 'roles' configurado: aplica can_edit estritamente.
    function canEditModule(companyId, moduleName) {
      let userRole = getUserRole();
      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId));
      let companyRoles = companyDoc.data.get('roles', {});
      let hasRolesConfig = 'roles' in companyDoc.data && companyRoles.size() > 0;
      let rolePerms = hasRolesConfig ? companyRoles.get(userRole, null) : null;
      let allowedArray = rolePerms != null ? rolePerms.get('can_edit', []) : [];

      return userRole != 'client'                                          // Client nunca escreve
        && (
          userRole == 'admin'                                              // Admin sempre passa
          || (!hasRolesConfig && userRole != 'client')                    // Sem config → não-client escreve
          || (hasRolesConfig && rolePerms != null                         // Com config → verifica can_edit
              && (moduleName in allowedArray || '*' in allowedArray))
        );
    }

    // super_admins — leitura apenas do próprio documento, escrita nunca pelo app
    match /super_admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Perfis de usuário raiz — usuário lê/escreve o próprio, super-admin lê/escreve qualquer
    match /users/{uid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid
        || isSuperAdmin()
      );
    }

    // collectionGroup queries para subcoleções que cruzam empresas
    match /{path=**}/subscriptions/{subscriptionId} {
      allow read, write: if request.auth != null && isUserInCompany(path[1]);
    }
    match /{path=**}/packages/{packageId} {
      allow read, write: if request.auth != null && isUserInCompany(path[1]);
    }

    // Escopo das empresas (SaaS multi-tenant)
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      // Usuários dentro da empresa
      match /users/{userId} {
        allow read, write: if request.auth != null && (
          isUserInCompany(companyId)
          || isSuperAdmin()
        );
      }

      // Ponto eletrônico — o próprio profissional ou admins da empresa
      match /professionals/{professionalId}/time_tracking/{recordId} {
        allow read: if request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId)
              && get(/databases/$(database)/documents/companies/$(companyId)/professionals/$(professionalId)).data.user_id == request.auth.uid)
        );
        // Escrita: profissional inativo não pode registrar ponto
        allow write: if request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId)
              && get(/databases/$(database)/documents/companies/$(companyId)/professionals/$(professionalId)).data.user_id == request.auth.uid
              && get(/databases/$(database)/documents/companies/$(companyId)/professionals/$(professionalId)).data.is_active != false)
        );
      }

      // Notificações
      match /admins/{adminId}/notifications/{notifId} {
        allow read, write: if request.auth != null && isUserInCompany(companyId);
      }
      match /professionals/{professionalId}/notifications/{notifId} {
        allow read, write: if request.auth != null && isUserInCompany(companyId);
      }

      // Demais coleções da empresa
      match /{module}/{document=**} {
        // Leitura — RBAC com fallback permissivo para empresas sem config
        allow read: if module != 'users' && request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId) && canViewModule(companyId, module))
          // Profissional sempre lê o próprio perfil (necessário no login)
          || (module == 'professionals' && isUserInCompany(companyId)
              && resource.data.user_id == request.auth.uid)
          // Catálogo público: serviços e planos para dropdowns
          || ((module == 'services' || module == 'subscription_plans' || module == 'packages')
              && isUserInCompany(companyId))
        );

        // Escrita — RBAC estrito: 'client' nunca escreve, config da empresa é respeitada,
        // fallback para empresas sem config (DEFAULT_ROLES: professional pode editar)
        allow write: if module != 'users' && request.auth != null
          && isUserInCompany(companyId)
          && canEditModule(companyId, module);
      }
    }

  }
}
