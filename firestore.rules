rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica se o usuário é um super-admin ativo
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/super_admins/$(request.auth.uid)).data.is_active == true;
    }

    // Verifica se o usuário pertence à empresa (Custom Claim com fallback no documento)
    function isUserInCompany(companyId) {
      return request.auth != null && (
        (request.auth.token.companyId != null && request.auth.token.companyId == companyId)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // Resolve o role do usuário (token claim com fallback no documento)
    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Verifica se o usuário é admin da empresa (role 'admin') ou super-admin
    function isAdmin(companyId) {
      return isSuperAdmin() || (isUserInCompany(companyId) && getUserRole() == 'admin');
    }

    // Traduz nome de coleção → ModuleKey da matriz de permissões.
    // A matriz (roles.<role>.can_view/can_edit) guarda ModuleKeys da UI
    // (fonte: src/modules/registry.ts); as rules recebem nomes de coleção.
    // Sem esta tradução, 'financial_records' nunca casaria com 'financial'.
    function moduleKeyOf(collectionName) {
      return collectionName == 'financial_records' ? 'financial'
        : collectionName == 'subscription_plans' ? 'services'
        : collectionName == 'packages' ? 'services'
        : collectionName == 'blocked_dates' ? 'appointments'
        : collectionName;
    }

    // RBAC de LEITURA por módulo.
    // Client nunca lê módulos (a área do paciente ainda não existe).
    // Fallback: empresa sem 'roles' configurado libera para qualquer não-client.
    function canViewModule(companyId, moduleName) {
      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId));
      let companyRoles = companyDoc.data.get('roles', {});
      let userRole = getUserRole();
      let rolePerms = companyRoles.get(userRole, null);
      let allowedArray = rolePerms != null ? rolePerms.get('can_view', []) : [];

      return userRole != 'client'
        && (
          !('roles' in companyDoc.data)               // Sem campo roles → libera (empresa legada)
          || companyRoles.size() == 0                 // Campo roles vazio → libera
          || rolePerms == null                        // Role não mapeado na empresa → libera
          // can_view vazio NEGA: um role criado no painel sem permissões
          // marcadas não pode herdar acesso total por acidente
          || userRole == 'admin'                      // Admin sempre passa
          || moduleKeyOf(moduleName) in allowedArray  // Módulo explicitamente permitido
          || '*' in allowedArray                      // Wildcard — acesso total
        );
    }

    // RBAC de ESCRITA por módulo.
    // Comportamento:
    //   - 'client' nunca pode escrever.
    //   - 'admin' sempre pode escrever.
    //   - Se a empresa NÃO tem 'roles' configurado: professional e outros roles (não client) podem
    //     escrever (fallback que reflete o DEFAULT_ROLES da aplicação).
    //   - Se a empresa TEM 'roles' configurado: aplica can_edit estritamente.
    function canEditModule(companyId, moduleName) {
      let userRole = getUserRole();
      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId));
      let companyRoles = companyDoc.data.get('roles', {});
      let hasRolesConfig = 'roles' in companyDoc.data && companyRoles.size() > 0;
      let rolePerms = hasRolesConfig ? companyRoles.get(userRole, null) : null;
      let allowedArray = rolePerms != null ? rolePerms.get('can_edit', []) : [];

      return userRole != 'client'                                          // Client nunca escreve
        && (
          userRole == 'admin'                                              // Admin sempre passa
          || (!hasRolesConfig && userRole != 'client')                    // Sem config → não-client escreve
          || (hasRolesConfig && rolePerms != null                         // Com config → verifica can_edit
              && (moduleKeyOf(moduleName) in allowedArray || '*' in allowedArray))
        );
    }

    // super_admins — leitura apenas do próprio documento, escrita nunca pelo app
    match /super_admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Perfis de usuário raiz — usuário lê/escreve o próprio, super-admin lê/escreve qualquer
    match /users/{uid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid
        || isSuperAdmin()
      );
    }

    // Vitrine pública de branding por slug — apenas nome/logo/cores, para a
    // tela de login white-label antes da autenticação
    match /public_branding/{slug} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Escopo das empresas (SaaS multi-tenant)
    match /companies/{companyId} {
      // Config completa (matriz de permissões, CNPJ, navbar) exige vínculo com a
      // empresa; o branding pré-login vive em public_branding
      allow read: if request.auth != null && (
        isUserInCompany(companyId)
        || isSuperAdmin()
      );
      allow write: if isSuperAdmin();

      // Usuários dentro da empresa
      match /users/{userId} {
        allow read, write: if request.auth != null && (
          isUserInCompany(companyId)
          || isSuperAdmin()
        );
      }

      // Entitlements do paciente (pacotes/assinaturas) — apenas staff da empresa.
      // Substituem as antigas regras de collectionGroup, que davam escrita a
      // qualquer usuário do tenant (inclusive role client).
      match /clients/{clientId}/packages/{packageId} {
        allow read, write: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
      }
      match /clients/{clientId}/subscriptions/{subscriptionId} {
        allow read, write: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
      }

      // Agregados mantidos pelas Cloud Functions (Admin SDK ignora rules):
      // nunca graváveis pelo app; leitura para staff da empresa
      match /monthly_summaries/{monthId} {
        allow read: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
        allow write: if false;
      }

      // Índices planos de assinaturas/pacotes dos pacientes — mantidos pelas
      // Cloud Functions (onEntitlementWrite); as telas de cobrança leem daqui
      // em 1 query em vez de varrer clients × subcoleções
      match /subscriptions_index/{subId} {
        allow read: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
        allow write: if false;
      }
      match /client_packages_index/{pkgId} {
        allow read: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
        allow write: if false;
      }

      // Trilha de auditoria financeira — append-only: cria, nunca edita/apaga
      match /financial_audit/{auditId} {
        allow read: if request.auth != null && isAdmin(companyId);
        allow create: if request.auth != null
          && isUserInCompany(companyId)
          && getUserRole() != 'client';
        allow update, delete: if false;
      }

      // Registros financeiros — o registro da sessão avulsa é criado pela
      // Cloud Function setAppointmentStatus (Admin SDK); no client, apenas os
      // fluxos de cobrança do admin (quitar/estornar mensalidade e pacote)
      match /financial_records/{recordId} {
        allow read: if request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId) && canViewModule(companyId, 'financial_records'))
        );
        allow create, update, delete: if request.auth != null && isAdmin(companyId);
      }

      // Disponibilidade — a montagem de slots da agenda lê a grade de qualquer
      // profissional; edição é do admin (o portal do profissional é read-only)
      match /professionals/{professionalId}/recurring_availability/{docId} {
        allow read: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
        allow write: if request.auth != null && isAdmin(companyId);
      }
      match /professionals/{professionalId}/availability_overrides/{docId} {
        allow read: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
        allow write: if request.auth != null && isAdmin(companyId);
      }

      // Prontuário (evoluções) — o profissional escreve a evolução dos
      // atendimentos sem precisar de can_edit no cadastro do paciente
      match /clients/{clientId}/notes/{noteId} {
        allow read, write: if request.auth != null && (
          isSuperAdmin()
          || (isUserInCompany(companyId) && getUserRole() != 'client')
        );
      }

      // Ponto eletrônico — o próprio profissional ou admins da empresa
      match /professionals/{professionalId}/time_tracking/{recordId} {
        allow read: if request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId)
              && get(/databases/$(database)/documents/companies/$(companyId)/professionals/$(professionalId)).data.user_id == request.auth.uid)
        );
        // Escrita: profissional inativo não pode registrar ponto
        allow write: if request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId)
              && get(/databases/$(database)/documents/companies/$(companyId)/professionals/$(professionalId)).data.user_id == request.auth.uid
              && get(/databases/$(database)/documents/companies/$(companyId)/professionals/$(professionalId)).data.is_active != false)
        );
      }

      // Notificações — cada um lê/gerencia as próprias; criação por staff
      // (ex.: "Prontuário Pendente" criado por quem conclui o atendimento)
      match /admins/{adminId}/notifications/{notifId} {
        allow read, update, delete: if request.auth != null
          && isUserInCompany(companyId)
          && request.auth.uid == adminId;
        allow create: if request.auth != null
          && isUserInCompany(companyId)
          && getUserRole() != 'client';
      }
      match /professionals/{professionalId}/notifications/{notifId} {
        allow read, update, delete: if request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId)
              && get(/databases/$(database)/documents/companies/$(companyId)/professionals/$(professionalId)).data.user_id == request.auth.uid)
        );
        allow create: if request.auth != null
          && isUserInCompany(companyId)
          && getUserRole() != 'client';
      }

      // Demais coleções da empresa
      match /{module}/{document=**} {
        // Leitura — RBAC com fallback permissivo para empresas sem config
        allow read: if module != 'users' && module != 'monthly_summaries' && module != 'financial_audit'
          && module != 'financial_records'
          && request.auth != null && (
          isAdmin(companyId)
          || (isUserInCompany(companyId) && canViewModule(companyId, module))
          // Profissional sempre lê o próprio perfil (necessário no login)
          || (module == 'professionals' && isUserInCompany(companyId)
              && resource.data.user_id == request.auth.uid)
          // Catálogo para dropdowns — staff apenas (não há área do paciente)
          || ((module == 'services' || module == 'subscription_plans' || module == 'packages')
              && isUserInCompany(companyId) && getUserRole() != 'client')
        );

        // Escrita — RBAC estrito: 'client' nunca escreve, config da empresa é respeitada,
        // fallback para empresas sem config (DEFAULT_ROLES: professional pode editar)
        allow write: if module != 'users' && module != 'monthly_summaries' && module != 'financial_audit'
          && module != 'financial_records'
          && request.auth != null
          && (
            isSuperAdmin()
            || (isUserInCompany(companyId) && canEditModule(companyId, module))
          );
      }
    }

  }
}
